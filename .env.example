# Server Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://shadify_api_role:password@localhost:5432/shadify_db?schema=public

# Cloudflare Ingress Security
CLOUDFLARE_HMAC_SECRET=dev-cloudflare-hmac-secret-min-32-chars-long
CLOUDFLARE_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=shadify-photos
R2_PUBLIC_DOMAIN=https://photos.shadify.in

# Google Cloud Platform Identity / OIDC
GCP_PROJECT_ID=shadify-production
GCP_ALB_FORWARDING_RULE_VIP=10.0.0.100
EXPECTED_OIDC_AUDIENCE=https://shadify-api-internal-bff

